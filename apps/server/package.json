{
  "name": "@ksi-core/server",
  "type": "module",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test src/domain",
    "dev": "bun --env-file=../../.env --env-file=.env run --watch src/index.ts",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "check": "tsc --noEmit",
    "worker": "bun run src/worker.ts",
    "operator": "bun run src/operator.ts",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@elysia/cors": "^1.4.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/ms": "^2.1.0",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "^1.4.29",
    "ms": "^2.1.3",
    "nodemailer": "^10.1.0",
    "pg": "^8.22.0",
    "shared": "workspace:*",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "bun-types": "^1.3.14",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "typescript": "6.0.2"
  }
}
