{
  "name": "ksi-website",
  "version": "0.0.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "clean": "rm -rf node_modules apps/server/node_modules apps/web/node_modules",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "dev:frontend": "bun run --cwd apps/web dev",
    "dev:backend": "bun run --cwd apps/server dev",
    "dev": "concurrently -n \"server,web\" -c \"bgGreen,bgBlue\" \"bun run dev:backend\" \"bun run dev:frontend\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "bun-types": "^1.3.12",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.52.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,yaml,toml,html,css,md,vue,svelte}": "bunx oxfmt"
  }
}
