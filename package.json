{
  "name": "ksi-core",
  "version": "2026.10.17",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "version:bump": "bun scripts/bump-version.ts",
    "clean": "rm -rf node_modules apps/server/node_modules apps/web/node_modules apps/auth/node_modules apps/dashboard/node_modules",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "db:seed": "bun run --cwd apps/server db:seed",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:auth": "bun run --cwd apps/auth dev",
    "dev:dash": "bun run --cwd apps/dashboard dev",
    "dev:backend": "bun run --cwd apps/server dev",
    "dev": "bun --env-file=.env run dev:all",
    "dev:all": "concurrently -n \"server,web,auth,dash\" -c \"bgGreen,bgBlue,bgMagenta,bgCyan\" \"bun run dev:backend\" \"bun run dev:web\" \"bun run dev:auth\" \"bun run dev:dash\"",
    "prepare": "husky",
    "test": "bun test apps/server/src/domain apps/server/src/routes/platform/access.test.ts packages/shared apps/dashboard/src/lib/navigation.test.ts",
    "check": "bun run --cwd apps/server check && bun run --cwd apps/web check && bun run --cwd apps/auth check && bun run --cwd apps/dashboard check",
    "lint": "oxlint",
    "format:check": "oxfmt --check .",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/auth build && bun run --cwd apps/dashboard build",
    "test:integration": "bun test apps/server/src/integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "peerDependencies": {
    "typescript": "6.0.2"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,yaml,toml,html,css,md,vue,svelte}": "bunx oxfmt",
    "*.{js,ts,jsx,tsx,svelte}": "bunx oxlint"
  },
  "packageManager": "bun@1.3.14"
}
