{
  "name": "ksi-core",
  "version": "0.0.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "clean": "rm -rf node_modules apps/server/node_modules apps/landing/node_modules",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "dev:auth": "bun run --cwd apps/auth dev --port 5174",
    "dev:landing": "bun run --cwd apps/landing dev --port 5173",
    "dev:backend": "bun run --cwd apps/server dev",
    "dev": "concurrently -n \"server,landing,auth\" -c \"bgMagenta,bgGreen,bgBlue\" \"bun run dev:backend\" \"bun run dev:landing\" \"bun run dev:auth\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,yaml,toml,html,css,md,vue,svelte}": "bunx oxfmt",
    "*.{js,ts,jsx,tsx,svelte}": "bunx oxlint"
  }
}
